{% extends "bare.njk" %}
{% block title %}{{ t('twoFactor.codesTitle') }}{% endblock %}
{% block content %}
<h1>{{ t('twoFactor.codesTitle') }}</h1>
<p class="sub">{{ t('twoFactor.codesSub') }}</p>
<ul class="codes" dir="ltr">
  {% for c in codes %}<li><code>{{ c }}</code></li>{% endfor %}
</ul>
<p class="note">{{ t('twoFactor.codesOnce') }}</p>
<a class="btn btn-primary btn-block" href="/platform">{{ t('twoFactor.codesDone') }}</a>
{% endblock %}
