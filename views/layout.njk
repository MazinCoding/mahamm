<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<meta name="apple-mobile-web-app-title" content="{{ appName }}">
<meta name="csrf-token" content="{{ csrfToken }}">
<meta name="referrer" content="same-origin">
<title>{% block title %}{{ appName }}{% endblock %} · {{ appName }}</title>
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
<link rel="stylesheet" href="/static/fonts/fonts.css">
<link rel="stylesheet" href="/static/css/app.css">
<script src="/static/js/app.js" defer></script>
</head>
<body class="has-tabbar">
<a class="skip" href="#main">{{ t('nav.skip') }}</a>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/home">
      <span class="brand-mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
      <span class="brand-text"><span class="brand-name">{{ appName }}</span><span class="brand-sub">{{ t('nav.sub') }}</span></span>
    </a>
    <nav class="nav" aria-label="{{ t('nav.main') }}">
      <a href="/home" {% if section == 'home' %}aria-current="page"{% endif %}>{{ t('nav.home') }}</a>
      <a href="/board" {% if section == 'board' %}aria-current="page"{% endif %}>{{ t('nav.board') }}</a>
      <a href="/tasks" {% if section == 'tasks' %}aria-current="page"{% endif %}>{{ t('nav.list') }}</a>
      <a href="/table" {% if section == 'table' %}aria-current="page"{% endif %}>{{ t('nav.table') }}</a>
      <a href="/audit" {% if section == 'audit' %}aria-current="page"{% endif %}>{{ t('nav.audit') }}</a>
      {% if user.isAdmin %}
      <a href="/people" {% if section == 'people' %}aria-current="page"{% endif %}>{{ t('nav.people') }}</a>
      <a href="/labels" {% if section == 'labels' %}aria-current="page"{% endif %}>{{ t('nav.labels') }}</a>
      <a href="/import" {% if section == 'import' %}aria-current="page"{% endif %}>{{ t('nav.import') }}</a>
      {% endif %}
    </nav>
    <div class="topbar-tools">
      <form method="post" action="/lang" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="lang" value="{{ 'en' if lang == 'ar' else 'ar' }}">
        <input type="hidden" name="next" value="{{ currentUrl }}">
        <button class="btn btn-secondary btn-sm" type="submit" lang="{{ 'en' if lang == 'ar' else 'ar' }}">{{ 'English' if lang == 'ar' else 'العربية' }}</button>
      </form>
      <a class="bell" href="/notifications" aria-label="{% if unread %}{{ t('nav.notificationsUnread', { n: unread }) }}{% else %}{{ t('nav.notifications') }}{% endif %}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>
        {% if unread %}<span class="badge" aria-hidden="true">{{ unread if unread < 100 else '99+' }}</span>{% endif %}
      </a>
      <span class="topbar-account">
        <a class="me" href="/settings" title="{{ t('nav.settings') }}">
          <span class="av {{ avatarClass(user.id) }}" aria-hidden="true">{{ initials(user.name) }}</span>
          <span class="me-name">{{ user.name }}</span>
        </a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button class="btn btn-link btn-sm" type="submit">{{ t('nav.signOut') }}</button>
        </form>
      </span>
    </div>
  </div>
</header>
<main id="main" class="container">
  {% if flash %}<div class="flash flash-{{ flash.type }}" role="status">{{ flash.text }}
    {%- if flash.undo %}
    <form method="post" action="/tasks/bulk/undo" class="inline flash-undo">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="batch" value="{{ flash.undo }}">
      <input type="hidden" name="back" value="{{ currentUrl }}">
      <button class="btn btn-link btn-sm" type="submit">{{ t('undo.button') }}</button>
    </form>
    {%- endif %}</div>{% endif %}
  {% block content %}{% endblock %}
</main>
{# Phones: two tabs at the bottom. Home is the start page; everything else is under Mahamm. #}
{% set onHome = section == 'home' or section == 'suggested' %}
<nav class="tabbar" aria-label="{{ t('nav.tabs') }}">
  <a class="tab-link{% if onHome %} is-active{% endif %}" href="/home"{% if section == 'home' %} aria-current="page"{% endif %}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/></svg>
    <span>{{ t('nav.home') }}</span>
  </a>
  <a class="tab-link{% if not onHome %} is-active{% endif %}" href="/mahamm"{% if section == 'mahamm' %} aria-current="page"{% endif %}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg>
    <span>{{ appName }}</span>
  </a>
</nav>
</body>
</html>
