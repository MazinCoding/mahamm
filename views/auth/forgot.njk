{% extends "bare.njk" %}
{% block title %}{{ t('auth.forgotTitle') }}{% endblock %}
{% block content %}
<h1>{{ t('auth.forgotTitle') }}</h1>
{% if sent %}
  <p>{{ t('auth.forgotSent') }}</p>
  <p class="auth-foot"><a class="link-sm" href="/login">{{ t('auth.backToSignIn') }}</a></p>
{% else %}
  <p class="sub">{{ t('auth.forgotSub') }}</p>
  <form class="form" method="post" action="/forgot">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="field">
      <label for="email">{{ t('auth.email') }}</label>
      <input id="email" class="input" type="email" name="email" autocomplete="username" required dir="ltr" maxlength="254">
    </div>
    <button class="btn btn-primary btn-block" type="submit">{{ t('auth.sendLink') }}</button>
  </form>
  <p class="auth-foot">{{ t('auth.forgotNoEmail') }} <a class="link-sm" href="/login">{{ t('auth.backToSignIn') }}</a></p>
{% endif %}
{% endblock %}
