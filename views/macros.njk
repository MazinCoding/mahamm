{% macro avatar(person, size='') %}<span class="av {{ avatarClass(person.id) }} {{ size }}" role="img" aria-label="{{ person.name }}" title="{{ person.name }}">{{ initials(person.name) }}</span>{% endmacro %}

{% macro avatars(people) %}{% if people.length %}<span class="avatars">{% for p in people %}{{ avatar(p) }}{% endfor %}</span>{% endif %}{% endmacro %}

{% macro label(l) %}<span class="chip c-{{ l.color }}">{{ labelName(l) }}</span>{% endmacro %}

{% macro prio(p) %}<span class="prio prio-{{ p }}">{{ t('priority.' + p) }}</span>{% endmacro %}

{% macro stateIcon(task) %}
{%- if not task.closed_at -%}
<svg class="ic ic-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" role="img" aria-label="{{ t('state.open') }}"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.2" fill="currentColor"/></svg>
{%- elif task.close_reason == 'completed' -%}
<svg class="ic ic-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="{{ t('reason.completed') }}"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
{%- else -%}
<svg class="ic ic-skip" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" role="img" aria-label="{{ t('reason.' + task.close_reason) }}"><circle cx="12" cy="12" r="9"/><line x1="7.5" y1="16.5" x2="16.5" y2="7.5"/></svg>
{%- endif -%}
{% endmacro %}

{% macro closedLine(task) %}
{%- if task.close_reason == 'completed' -%}
{%- if task.credits.length -%}{{ t('task.completedBy', { people: task.credits | join(t('common.listSep'), 'name') }) }}{%- else -%}{{ t('task.completedByUnknown') }}{%- endif -%}
{%- else -%}{{ t('task.closedAs', { reason: t('reason.' + task.close_reason) }) }}{%- endif -%}
{% endmacro %}

{% macro card(task, today) %}
<article class="task-card" draggable="true" data-task-id="{{ task.id }}">
  <div class="card-top">
    <span class="num">{% if task.closed_at %}{{ stateIcon(task) }}{% endif %}#{{ task.id }}</span>
    <span class="card-marks">
      {% if task.open_flags %}<span class="flag-mark" title="{{ t('flag.flagged') }}"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg><span class="sr-only">{{ t('flag.flagged') }}</span></span>{% endif %}
      {{ prio(task.priority) }}
    </span>
  </div>
  <a class="card-title stretch" dir="auto" href="/tasks/{{ task.id }}">{{ task.title }}</a>
  {% if task.labels.length %}<div class="chips">{% for l in task.labels %}{{ label(l) }}{% endfor %}</div>{% endif %}
  {% if task.closed_at %}<div class="closed-line{% if task.close_reason == 'completed' %} is-done{% endif %}">{{ closedLine(task) }}</div>{% endif %}
  <div class="card-foot">
    {% if task.due_date and not task.closed_at %}
    <span class="due{% if task.due_date < today %} is-overdue{% endif %}">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="3" y1="11" x2="21" y2="11"/></svg>
      {% if task.due_date < today %}{{ t('task.overdue', { d: fmt.short(task.due_date) }) }}{% else %}{{ t('task.due', { d: fmt.short(task.due_date) }) }}{% endif %}
    </span>
    {% endif %}
    {% if task.comment_count %}<span class="meta-count"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>{{ task.comment_count }}<span class="sr-only"> {{ t('task.commentsSr') }}</span></span>{% endif %}
    {% if task.file_count %}<span class="meta-count"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.4 11.1l-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>{{ task.file_count }}<span class="sr-only"> {{ t('task.filesSr') }}</span></span>{% endif %}
    <span class="grow"></span>
    {{ avatars(task.credits if task.closed_at else task.assignees) }}
  </div>
</article>
{% endmacro %}

{% macro field_error(errors, name) %}{% if errors[name] %}<p class="error" id="err-{{ name }}">{{ t('form.err.' + name) }}</p>{% endif %}{% endmacro %}

{# Home: a task you could pick up, with who is on it (or "Nobody yet") and a Join button. #}
{% macro suggestCard(task, today, back) %}
<li class="my-task suggest" data-task-id="{{ task.id }}">
  <div class="my-meta">
    <span class="num">#{{ task.id }}</span>
    {{ prio(task.priority) }}
    <span class="status-chip s-{{ task.status }}">{{ t('status.' + task.status) }}</span>
    {% if task.open_flags %}<span class="chip c-red">{{ t('flag.flagged') }}</span>{% endif %}
    <span class="grow"></span>
    {% if not task.due_date %}<span class="missing">{{ t('table.noDue') }}</span>
    {% elif task.due_date < today %}<span class="due is-overdue">{{ t('task.overdue', { d: fmt.short(task.due_date) }) }}</span>
    {% else %}<span class="due">{{ t('task.due', { d: fmt.short(task.due_date) }) }}</span>{% endif %}
  </div>
  <a class="my-title" dir="auto" href="/tasks/{{ task.id }}">{{ task.title }}</a>
  {% if task.labels.length %}<div class="chips">{% for l in task.labels %}{{ label(l) }}{% endfor %}</div>{% endif %}
  <div class="suggest-foot">
    <span class="suggest-people">
      {% if task.assignees.length %}{{ avatars(task.assignees) }}<span><bdi>{{ task.assignees[0].name }}</bdi>{% if task.assignees.length > 1 %} {{ t('home.andN', { n: task.assignees.length - 1 }) }}{% endif %}</span>
      {% else %}<span class="missing">{{ t('home.nobodyYet') }}</span>{% endif %}
    </span>
    <form method="post" action="/tasks/{{ task.id }}/join" class="inline">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <input type="hidden" name="back" value="{{ back }}">
      <button class="btn btn-primary btn-sm join-btn" type="submit">{{ t('home.join') }}<span class="sr-only"> #{{ task.id }}</span></button>
    </form>
  </div>
</li>
{% endmacro %}
