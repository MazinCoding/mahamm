{% extends "layout.njk" %}
{% import "macros.njk" as m with context %}
{% block title %}{{ t('list.title') }}{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>{{ t('list.title') }}</h1>
    <p class="sub">{{ t('list.sub') }}</p>
  </div>
  <div class="head-actions"><a class="btn btn-primary" href="/tasks/new">{{ t('task.new') }}</a></div>
</div>

<div class="box">
  <form class="toolbar" method="get" action="/tasks" role="search">
    {% if filters.state == 'closed' %}<input type="hidden" name="state" value="closed">{% endif %}
    <div class="tabs">
      <a class="tab" href="{{ openUrl }}" {% if filters.state == 'open' %}aria-current="true"{% endif %}>{{ m.stateIcon({ closed_at: false }) }}{{ counts.open }} {{ t('state.open') }}</a>
      <a class="tab" href="{{ closedUrl }}" {% if filters.state == 'closed' %}aria-current="true"{% endif %}>{{ m.stateIcon({ closed_at: 1, close_reason: 'completed' }) }}{{ counts.closed }} {{ t('state.closed') }}</a>
    </div>
    <span class="grow"></span>
    <label class="sr-only" for="f-q">{{ t('list.search') }}</label>
    <input id="f-q" class="input" type="search" name="q" value="{{ filters.q }}" placeholder="{{ t('list.searchPh') }}" maxlength="100">
    <label class="sr-only" for="f-label">{{ t('field.labels') }}</label>
    <select id="f-label" class="input" name="label" data-autosubmit>
      <option value="">{{ t('list.allLabels') }}</option>
      {% for l in labels %}<option value="{{ l.id }}" {% if filters.label == l.id %}selected{% endif %}>{{ labelName(l) }}</option>{% endfor %}
    </select>
    <label class="sr-only" for="f-person">{{ t('list.person') }}</label>
    <select id="f-person" class="input" name="person" data-autosubmit>
      <option value="">{{ t('list.anyone') }}</option>
      {% for p in people %}<option value="{{ p.id }}" {% if filters.person == p.id %}selected{% endif %}>{{ p.name }}</option>{% endfor %}
    </select>
    <label class="sr-only" for="f-prio">{{ t('field.priority') }}</label>
    <select id="f-prio" class="input" name="priority" data-autosubmit>
      <option value="">{{ t('list.anyPriority') }}</option>
      {% for p in ['high', 'med', 'low'] %}<option value="{{ p }}" {% if filters.priority == p %}selected{% endif %}>{{ t('priority.' + p) }}</option>{% endfor %}
    </select>
    <label class="check-inline"><input type="checkbox" name="flagged" value="1" data-autosubmit {% if filters.flagged %}checked{% endif %}> {{ t('list.flaggedOnly') }}</label>
    <button class="btn btn-secondary btn-sm" type="submit">{{ t('list.apply') }}</button>
    {% if hasFilters %}<a class="link-sm" href="{{ '/tasks?state=closed' if filters.state == 'closed' else '/tasks' }}">{{ t('list.clear') }}</a>{% endif %}
  </form>

  {% for task in rows %}
  <div class="row">
    <span class="row-icon">{{ m.stateIcon(task) }}</span>
    <div class="row-main">
      <div class="row-title-line">
        <a class="row-title" href="/tasks/{{ task.id }}">{{ task.title }}</a>
        {% for l in task.labels %}{{ m.label(l) }}{% endfor %}
        {% if task.open_flags %}<span class="chip c-red">{{ t('flag.flagged') }}</span>{% endif %}
      </div>
      <div class="row-meta">
        <span class="num">#{{ task.id }}</span>
        {% if task.closed_at %}
          {{ t('list.closedMeta', { t: fmt.ago(task.closed_at), p: task.closed_by_name }) }} · {{ m.closedLine(task) }}
        {% else %}
          {{ t('list.openedMeta', { t: fmt.ago(task.created_at), p: task.creator_name }) }}
        {% endif %}
      </div>
    </div>
    {% if not task.closed_at %}<span class="status-chip s-{{ task.status }}">{{ t('status.' + task.status) }}</span>{% endif %}
    {{ m.avatars(task.credits if task.closed_at else task.assignees) }}
    <span class="row-count">{% if task.comment_count %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg>{{ task.comment_count }}<span class="sr-only"> {{ t('task.commentsSr') }}</span>{% endif %}</span>
  </div>
  {% else %}
  <div class="empty">
    <p>{{ t('list.empty') }}</p>
    {% if hasFilters %}<a class="link-sm" href="/tasks">{{ t('list.clear') }}</a>{% endif %}
  </div>
  {% endfor %}
</div>

{% if prevUrl or nextUrl %}
<nav class="pager" aria-label="{{ t('list.pages') }}">
  {% if prevUrl %}<a class="btn btn-secondary btn-sm" href="{{ prevUrl }}">{{ t('list.prev') }}</a>{% endif %}
  <span>{{ t('list.pageOf', { page: filters.page, pages: pages }) }}</span>
  {% if nextUrl %}<a class="btn btn-secondary btn-sm" href="{{ nextUrl }}">{{ t('list.next') }}</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
