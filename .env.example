# Copy to .env for local development. Names only; never commit real values.
NODE_ENV=development
PORT=3000
APP_NAME=Mahamm
# Public address of the site. Required in production and must be https.
APP_URL=
APP_TIMEZONE=Asia/Muscat

DATABASE_URL=
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_CA_CERT=
# Optional: a separate owner account just for running migrations.
MIGRATION_DATABASE_URL=

# Long random strings (at least 32 characters each).
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Optional: previous session secret while rotating.
SESSION_SECRET_PREVIOUS=
# Only needed once, to create the first admin at /setup.
SETUP_TOKEN=

# Email (all five or none). Gmail: smtp.gmail.com, port 587, an app password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional tuning
TRUST_PROXY=
WIP_LIMIT=5
PASSWORD_BREACH_CHECK=
LOG_LEVEL=info

# Tests only
TEST_DATABASE_URL=
